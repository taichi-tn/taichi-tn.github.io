    BlogCommentReplay = {};

    // テンプレートとなる要素を取得
    var $comment_template = $("#comment_template");


    /** 最初に呼ばれるメソッド */
    BlogCommentReplay.init = function() {
        // bodyに入れておく
        $("body").prepend($comment_template);
        // イベント付与
