;(function($) {
//チャンネルタグの開閉
var minHeight  = 16,
    scrlMargin = 4.5,
    scrlHeight,
    tagsContainer,
    classNames = {hidden: 'hidden', expand: 'expand'},
    selectors  = {tags: '#chhd_b_tag', more: '.more', buttons: 'a'};

var fn = {
    init: function() {
        tagsContainer = $(selectors.tags);
        if(!tagsContainer[0]){return false;};//tagsContainerが無ければ終わる
        scrlHeight = tagsContainer[0].scrollHeight
        if (scrlHeight - tagsContainer[0].clientHeight - scrlMargin <= 0) return;

        tagsContainer
            .siblings(selectors.more).removeClass(classNames.hidden)
                .find(selectors.buttons).bind('click', fn.toggle);
    },
    toggle: function(e) {
        e.preventDefault();
        var el = $(this), f = el.hasClass(classNames.expand);
        el.hide().siblings().css('display', 'block');
        tagsContainer.stop().animate({height: f ? scrlHeight : minHeight},50);
    }
};

$(fn.init);

})(jQuery);


jQuery(function($){
    //DOM readyを待つ

    debug=0;

    //二重課金防止
    var ppvSubmit = {
        fire: function(event){//とにかくボタンを押したとき発火
