        }
    }
    if($(".purchase_method").size()>=1){
        debug&&console.log($(".purchase_method").size());
        var btnPpvSubmit = $("form.purchaseForm input.ppvSubmit");
        btnPpvSubmit.click(ppvSubmit.fire);
    }

    //CPペナルティバーの解除日表示の切り替え
    var $pena_bar = $("header.site .head_msg.penalty");
    if($pena_bar.size()!=0){
        var $pena_trigger     = $pena_bar.find(".until");
        var $pena_unlock_date = $pena_bar.find(".unlock_date");
        $pena_trigger.on("click",function(){
            $pena_unlock_date.fadeToggle();
        });
    }


});


//SNS共有メニュー開閉：ヘッダHTMLとfollow.jsから呼ばれます
var toggleShareMenu = function(expand){
    if(expand){
        panel.slideDown(50);
        trigger.addClass("expanded");
    }else{
        panel.slideUp(50);
        trigger.removeClass("expanded");
    }
}
